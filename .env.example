POSTGRES_DB=habi_poc
POSTGRES_USER=habi
POSTGRES_PASSWORD=habi_local_password
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173
HABI_DATABASE_URL=postgresql+psycopg://habi:habi_local_password@postgres:5432/habi_poc
VITE_API_PROXY_TARGET=http://backend:8000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
OPENAI_FREE_FORM_MODEL=gpt-5.5-2026-04-23
OPENAI_FREE_FORM_REASONING_EFFORT=high
OPENAI_FREE_FORM_RETRY_REASONING_EFFORT=xhigh
OPENAI_FREE_FORM_RETRIES_ENABLED=true
OPENAI_FREE_FORM_MAX_INPUT_CHARS=800000
OPENAI_CLIENT_MAX_RETRIES=2
OPENAI_BASE_URL=https://api.openai.com/v1
HABI_OPENAI_STORE_RESPONSES=true
HABI_STORAGE_ROOT=/app/data
HABI_XLSX_MAX_UPLOAD_BYTES=26214400
HABI_XLSX_MAX_VISIBLE_WORKSHEETS=10
HABI_XLSX_MAX_NON_EMPTY_ROWS=2000
HABI_XLSX_MAX_NON_EMPTY_CELLS=50000
HABI_XLSX_EXTRACTION_CHUNK_ROWS=100
