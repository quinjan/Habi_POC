{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://habi.local/schemas/free-form-promotion-record-v1.json",
  "title": "Habi Free-Form GPT-5.5 Promotion Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "evaluator_version", "repository_commit", "configuration", "fingerprints", "attempts", "metrics", "prior_attempt_summaries"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "evaluator_version": {"type": "string", "minLength": 1},
    "repository_commit": {"type": "string", "minLength": 7},
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "reasoning_effort", "application_retries_enabled", "client_max_retries"],
      "properties": {
        "model": {"const": "gpt-5.5-2026-04-23"},
        "reasoning_effort": {"const": "high"},
        "application_retries_enabled": {"const": false},
        "client_max_retries": {"const": 0}
      }
    },
    "fingerprints": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "required": ["prompt_template_sha256", "response_schema_sha256", "request_config_sha256"]
    },
    "attempts": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["position", "fixture_id", "fixture_version", "manifest_sha256", "rendered_input_sha256", "model_call_count", "retry_enabled", "outcome", "strict_comparison_passed", "latency_ms", "usage", "estimated_cost", "artifact_sha256"],
        "properties": {
          "position": {"type": "integer", "minimum": 1, "maximum": 10},
          "fixture_id": {"type": "string"},
          "fixture_version": {"type": "integer", "minimum": 1},
          "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "rendered_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "model_call_count": {"const": 1},
          "retry_enabled": {"const": false},
          "outcome": {"const": "pass"},
          "strict_comparison_passed": {"const": true},
          "latency_ms": {"type": "number", "minimum": 0},
          "usage": {"type": "object"},
          "estimated_cost": {"type": "number", "minimum": 0},
          "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "metrics": {"type": "object"},
    "prior_attempt_summaries": {"type": "array", "items": {"type": "object"}}
  }
}
